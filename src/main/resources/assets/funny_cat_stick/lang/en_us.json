  "message.funny_cat_stick.personality.tough.0": "Hmph. %1$s",
  "message.funny_cat_stick.personality.tough.1": "Listen up. %1$s",
  "message.funny_cat_stick.personality.tough.2": "%1$s. Don't slow us down.",
  "message.funny_cat_stick.personality.tough.3": "%1$s. That's an order.",
  "message.funny_cat_stick.personality.tough.4": "Attention! %1$s",
  "message.funny_cat_stick.personality.tough.5": "%1$s. Execute immediately.",
  "message.funny_cat_stick.personality.tough.6": "Reporting in. %1$s",
  "message.funny_cat_stick.personality.tough.7": "%1$s. No objections.",
  "message.funny_cat_stick.personality.tough.8": "Tch... %1$s (\uffe2_\uffe2)",
  "message.funny_cat_stick.personality.tough.9": "%1$s. Is that understood?",
  "message.funny_cat_stick.personality.tough.10": "Move it. %1$s",
  "message.funny_cat_stick.personality.tough.11": "%1$s! Step to it!",
  "message.funny_cat_stick.personality.tough.12": "Mission confirmed: %1$s",
  "message.funny_cat_stick.personality.tough.13": "%1$s ( \u2022\u0300\u03c9\u2022\u0301 )\u309d",
  "message.funny_cat_stick.personality.yandere.0": "%1$s... You may only look at me\u2661",
  "message.funny_cat_stick.personality.yandere.1": "%1$s. Let's stay together forever\u2661",
  "message.funny_cat_stick.personality.yandere.2": "Hey, %1$s... You won't leave me, right?",
  "message.funny_cat_stick.personality.yandere.3": "%1$s. If you forget me... hee hee\u2661",
  "message.funny_cat_stick.personality.yandere.4": "I'm always watching you. %1$s",
  "message.funny_cat_stick.personality.yandere.5": "%1$s... No one is taking you away from me\u2661",
  "message.funny_cat_stick.personality.yandere.6": "You're all I need. %1$s",
  "message.funny_cat_stick.personality.yandere.7": "%1$s. Promise you won't disappear, okay?",
  "message.funny_cat_stick.personality.yandere.8": "Hee hee... %1$s (\u25d5\u203f\u25d5\u273f)",
  "message.funny_cat_stick.personality.yandere.9": "%1$s. We'll be together forever and ever.",
  "message.funny_cat_stick.personality.yandere.10": "Don't look at anyone else. %1$s \u2661",
  "message.funny_cat_stick.personality.yandere.11": "%1$s... You can't escape me\u2661",
  "message.funny_cat_stick.personality.tsundere.0": "I-it's not like I'm saying this for you... %1$s",
  "message.funny_cat_stick.personality.tsundere.1": "%1$s. Don't get the wrong idea!",
  "message.funny_cat_stick.personality.tsundere.2": "%1$s, dummy.",
  "message.funny_cat_stick.personality.tsundere.3": "Hmph! %1$s",
  "message.funny_cat_stick.personality.tsundere.4": "%1$s. I was just reminding you, that's all!",
  "message.funny_cat_stick.personality.tsundere.5": "W-who cares! %1$s",
  "message.funny_cat_stick.personality.tsundere.6": "%1$s... It's not like I was worried.",
  "message.funny_cat_stick.personality.tsundere.7": "Don't get smug! %1$s",
  "message.funny_cat_stick.personality.tsundere.8": "%1$s (///\uffe3 \uffe3///)",
  "message.funny_cat_stick.personality.tsundere.9": "Honestly, you're hopeless... %1$s",
  "message.funny_cat_stick.personality.tsundere.10": "It's not like I wanted to talk to you! %1$s",
  "message.funny_cat_stick.personality.tsundere.11": "%1$s. I won't help you next time!",
  "message.funny_cat_stick.personality.energetic.0": "%1$s, yay!",
  "message.funny_cat_stick.personality.energetic.1": "%1$s, nyahaha!",
  "message.funny_cat_stick.personality.energetic.2": "%1$s! Let's do our best today!",
  "message.funny_cat_stick.personality.energetic.3": "Let's go! %1$s",
  "message.funny_cat_stick.personality.energetic.4": "%1$s! Charge!",
  "message.funny_cat_stick.personality.energetic.5": "Hehe, %1$s (\u2267\u25bd\u2266)",
  "message.funny_cat_stick.personality.energetic.6": "Full power! %1$s",
  "message.funny_cat_stick.personality.energetic.7": "%1$s! Nothing is impossible!",
  "message.funny_cat_stick.personality.energetic.8": "Awesome! %1$s",
  "message.funny_cat_stick.personality.energetic.9": "%1$s! Cheer up!",
  "message.funny_cat_stick.personality.energetic.10": "One, two, three--%1$s!",
  "message.funny_cat_stick.personality.energetic.11": "%1$s \u30fd(>\u2200<\u2606)\u30ce",
  "message.funny_cat_stick.personality.lazy.0": "%1$s... So sleepy...",
  "message.funny_cat_stick.personality.lazy.1": "%1$s... Five more minutes...",
  "message.funny_cat_stick.personality.lazy.2": "%1$s... Spare me...",
  "message.funny_cat_stick.personality.lazy.3": "Yaaawn... %1$s",
  "message.funny_cat_stick.personality.lazy.4": "%1$s... Let's do it tomorrow...",
  "message.funny_cat_stick.personality.lazy.5": "I don't want to move... %1$s",
  "message.funny_cat_stick.personality.lazy.6": "%1$s (\uff0d_\uff0d) zzZ",
  "message.funny_cat_stick.personality.lazy.7": "Mmm... %1$s...",
  "message.funny_cat_stick.personality.lazy.8": "%1$s... Can I say it lying down?",
  "message.funny_cat_stick.personality.lazy.9": "What a pain... %1$s",
  "message.funny_cat_stick.personality.lazy.10": "%1$s... Let me nap first...",
  "message.funny_cat_stick.personality.lazy.11": "Take it easy... %1$s",
  "message.funny_cat_stick.personality.sharp_tongued.0": "%1$s. That's it?",
  "message.funny_cat_stick.personality.sharp_tongued.1": "%1$s. Try not to die too quickly.",
  "message.funny_cat_stick.personality.sharp_tongued.2": "Tch. %1$s",
  "message.funny_cat_stick.personality.sharp_tongued.3": "%1$s. I suppose that's the best you can do.",
  "message.funny_cat_stick.personality.sharp_tongued.4": "You're such a handful. %1$s",
  "message.funny_cat_stick.personality.sharp_tongued.5": "%1$s. Has your brain finally caught up?",
  "message.funny_cat_stick.personality.sharp_tongued.6": "Heh. %1$s",
  "message.funny_cat_stick.personality.sharp_tongued.7": "%1$s. Barely acceptable.",
  "message.funny_cat_stick.personality.sharp_tongued.8": "Don't flatter yourself. %1$s",
  "message.funny_cat_stick.personality.sharp_tongued.9": "%1$s (\u00ac_\u00ac)",
  "message.funny_cat_stick.personality.sharp_tongued.10": "Do I have to teach you this too? %1$s",
  "message.funny_cat_stick.personality.sharp_tongued.11": "%1$s. At least stay out of the way.",
  "message.funny_cat_stick.personality.timid.0": "%1$s... Eep...",
  "message.funny_cat_stick.personality.timid.1": "N-no... %1$s",
  "message.funny_cat_stick.personality.timid.2": "%1$s... Can we hold hands?",
  "message.funny_cat_stick.personality.timid.3": "Um... %1$s",
  "message.funny_cat_stick.personality.timid.4": "%1$s... P-please don't be angry...",
  "message.funny_cat_stick.personality.timid.5": "I'll do my best... %1$s",
  "message.funny_cat_stick.personality.timid.6": "%1$s (\uff61\u2022\u0301\ufe3f\u2022\u0300\uff61)",
  "message.funny_cat_stick.personality.timid.7": "Don't leave me behind... %1$s",
  "message.funny_cat_stick.personality.timid.8": "%1$s... This is scary...",
  "message.funny_cat_stick.personality.timid.9": "P-please keep your voice down... %1$s",
  "message.funny_cat_stick.personality.timid.10": "%1$s... Can I hide behind you?",
  "message.funny_cat_stick.personality.timid.11": "Eek... %1$s",
  "message.funny_cat_stick.personality.airheaded.0": "%1$s... Huh?",
  "message.funny_cat_stick.personality.airheaded.1": "%1$s... Is that how it works?",
  "message.funny_cat_stick.personality.airheaded.2": "%1$s, meow?",
  "message.funny_cat_stick.personality.airheaded.3": "Eh? %1$s",
  "message.funny_cat_stick.personality.airheaded.4": "%1$s... What was I saying?",
  "message.funny_cat_stick.personality.airheaded.5": "Hmm... %1$s",
  "message.funny_cat_stick.personality.airheaded.6": "%1$s (\u30fb\u25c7\u30fb)?",
  "message.funny_cat_stick.personality.airheaded.7": "I see... probably? %1$s",
  "message.funny_cat_stick.personality.airheaded.8": "%1$s... Ehehe.",
  "message.funny_cat_stick.personality.airheaded.9": "That's odd, %1$s",
  "message.funny_cat_stick.personality.airheaded.10": "%1$s... Is this edible?",
  "message.funny_cat_stick.personality.airheaded.11": "Right, right! So... %1$s?",
  "message.funny_cat_stick.personality.nekomata_deity.0": "I am... %1$s",
  "message.funny_cat_stick.personality.nekomata_deity.1": "%1$s. Present your dried fish offering.",
  "message.funny_cat_stick.personality.nekomata_deity.2": "Mortal, %1$s",
  "message.funny_cat_stick.personality.nekomata_deity.3": "%1$s. Thus speaks the oracle.",
  "message.funny_cat_stick.personality.nekomata_deity.4": "Heed my decree: %1$s",
  "message.funny_cat_stick.personality.nekomata_deity.5": "%1$s. Have you committed it to memory?",
  "message.funny_cat_stick.personality.nekomata_deity.6": "I have seen through all things. %1$s",
  "message.funny_cat_stick.personality.nekomata_deity.7": "%1$s. Receive the cat god's blessing.",
  "message.funny_cat_stick.personality.nekomata_deity.8": "Silence. %1$s",
  "message.funny_cat_stick.personality.nekomata_deity.9": "%1$s (\u0e05\u03a6\u03c9\u03a6)\u0e05",
  "message.funny_cat_stick.personality.nekomata_deity.10": "In the name of the nekomata, %1$s",
  "message.funny_cat_stick.personality.nekomata_deity.11": "%1$s. Offer one more dried fish and I shall allow it.",
  "message.funny_cat_stick.tamed.0": "%1$s has been tamed! Their owner is %2$s, meow!",
  "message.funny_cat_stick.tamed.1": "%2$s waved the Funny Cat Stick, and now %1$s must behave, meow~",
  "message.funny_cat_stick.tamed.2": "Ding! %1$s has accepted %2$s as their owner. Take good care of this kitty!",
  "message.funny_cat_stick.tamed.3": "%1$s is wearing an invisible kitty collar. Their owner is %2$s, meow~",
  "message.funny_cat_stick.tamed.4": "Congratulations to %2$s for taming %1$s. Be a good kitty now!",
